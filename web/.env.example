# Copy to .env.local (local development) or set in Vercel (production).

# Postgres connection (local: Docker container from CLAUDE.md; production: Neon)
DATABASE_URL=postgresql://postgres:dev@localhost:5433/acc_coach

# Public address of the site (used for the Discord redirect)
APP_URL=http://localhost:3000

# Discord sign-in: https://discord.com/developers/applications → New Application → OAuth2.
# Redirect URL to add there: <APP_URL>/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The team's Discord server id (Discord settings → Advanced → Developer Mode, then right-click
# the server → Copy Server ID). Only its members can sign in.
DISCORD_GUILD_ID=

# Local development only: sign in as a test driver without Discord (ignored in production)
DEV_LOGIN=1

# Optional: team news (records, PBs, achievements) posted to a Discord channel. Channel settings >
# Integrations > Webhooks > New webhook > Copy webhook URL. Keep it secret (anyone with it can post).
DISCORD_WEBHOOK_URL=
